#!/usr/bin/env bash
# 发送一条消息到仓库信箱 mq/，提交并尝试推送到 GitHub
# 用法: qmsg [-s 主题] <消息>   或   echo 内容 | qmsg [-s 主题] -
set -euo pipefail
LC_ALL=C

usage() { echo "用法: qmsg [-s 主题] <消息> | qmsg [-s 主题] -  (从 stdin 读取)" >&2; }

subject=""
if [ "${1:-}" = "-s" ]; then
  [ $# -ge 2 ] || { usage; exit 2; }
  subject=$2
  shift 2
fi
[ $# -ge 1 ] || { usage; exit 2; }

if [ "$1" = "-" ]; then
  body=$(cat)
else
  body=$*
fi
[ -n "${body//[[:space:]]/}" ] || { echo "消息不能为空" >&2; exit 2; }
[ -n "$subject" ] || subject=$(printf '%s\n' "$body" | head -n1 | cut -c1-60)

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "请在 Git 仓库内运行" >&2; exit 1; }
cd "$top"

agent=$(git config --get sync.agent 2>/dev/null || true); [ -n "$agent" ] || agent=$(hostname -s)
agent=$(printf '%s' "$agent" | tr -cs 'A-Za-z0-9._-' '-' | sed 's/^-*//; s/-*$//')
[ -n "$agent" ] || agent=agent

ts=$(date -u +%Y%m%dT%H%M%SZ)
rand=$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')
mkdir -p mq
file="mq/${ts}-${agent}-${rand}.md"

{
  printf 'from: %s\n' "$agent"
  printf 'at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'subject: %s\n' "$subject"
  printf -- '---\n'
  printf '%s\n' "$body"
} >"$file"

git add "$file"
git commit --quiet -m "msg($agent): $subject"

remote=$(git config --get sync.remote 2>/dev/null || true); [ -n "$remote" ] || remote=origin
branch=$(git config --get sync.branch 2>/dev/null || true); [ -n "$branch" ] || branch=master

echo "已写入 $file"
if timeout 30 git push --quiet "$remote" "HEAD:$branch" 2>/dev/null; then
  echo "已推送"
else
  echo "推送暂未成功（守护进程或下次提交会重试）"
fi
